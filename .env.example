# Copy to .env.local and fill in real values. Set the same variables in Railway.
# Placeholders only: never put a real value in this file, because it is committed.
# The app refuses to start while any required value still says replace-with.

# Neon Postgres: use the POOLED connection string (host contains "-pooler").
# Use a development branch here, and the production branch only in Railway.
DATABASE_URL=postgresql://replace-with-user:replace-with-password@ep-replace-with-host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Signs session cookies. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 (S3-compatible image storage)
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=replace-with-bucket-name
# Public bucket URL, no trailing slash
R2_PUBLIC_URL=https://replace-with-bucket-id.r2.dev

# Only needed when running the seed scripts. Up to three users.
# Keep the single quotes in .env.local.
SEED_USERS='[{"email":"person@example.com","name":"Person","password":"change-me"}]'

# Development only: a warning banner shows when DATABASE_URL's host contains the
# hint. Put part of your production Neon host here, like ep-replace-with-host.
PRODUCTION_DB_HOST_HINT=
APP_ENV_LABEL=Production database
