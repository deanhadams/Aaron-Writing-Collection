# Copy to .env.local and fill in real values. Set the same variables in Railway.
# Never commit real values.

# Neon Postgres: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Accounts created by the seed script (no signup page)
SEED_USERS=[{"email":"deanh.adams@gmail.com","name":"Dean","password":"change-me"},{"email":"aaroncarteradams2305@gmail.com","name":"Aaron","password":"change-me"},{"email":"5223105@gmail.com","name":"Kim","password":"change-me"}]

# Cloudflare R2 (S3-compatible image storage)
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
# Public bucket URL, no trailing slash
R2_PUBLIC_URL=https://pub-example.r2.dev
